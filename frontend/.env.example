# Copy this file to .env for local development (never commit .env itself).
#
# Base origin of the Django backend API this frontend calls. Leave unset
# (or empty) to use same-origin relative paths - see
# frontend/src/lib/api.ts's safe fallback. Production builds (Vercel)
# must set the real value as a platform environment variable, not via a
# committed file - see docs/rebuild/P01A_STABILIZATION_REPORT.md §11.
VITE_API_BASE_URL=http://localhost:8000
